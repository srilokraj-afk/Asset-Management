        "body": {
          "mode": "raw",
          "raw": "{\n  \"assetTag\": \"LAP-POSTMAN-001\",\n  \"type\": \"LAPTOP\",\n  \"make\": \"Dell\",\n  \"model\": \"Latitude 5440\",\n  \"serialNumber\": \"SN-POSTMAN-001\",\n  \"purchaseDate\": \"2026-09-27\",\n  \"warrantyExpiry\": \"2029-09-27\",\n  \"costMinor\": 75000,\n  \"currency\": \"USD\",\n  \"condition\": \"NEW\",\n  \"notes\": \"Created from Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j=pm.response.json(); pm.collectionVariables.set('assetId',j.id);"
            ]
          }
        }
      ]
    },
    {
