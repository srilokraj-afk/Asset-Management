    {
      "name": "18 Inventory & Analytics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Session-Id",
            "value": "{{sessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/assets/analytics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assets",
            "analytics"
          ]
        },
        "description": "Returns lifecycle totals plus quantity by asset type, quantity by brand/manufacturer, quantity by type + brand, purchase analytics, warranty analytics and low-stock alerts."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j=pm.response.json(); pm.test('Analytics has inventory breakdowns', () => pm.expect(j).to.have.property('byType')); pm.test('Analytics has brand breakdowns', () => pm.expect(j).to.have.property('byMake')); pm.test('Analytics has purchase analytics', () => pm.expect(j).to.have.property('purchasedThisYear')); pm.test('Analytics has low-stock data', () => pm.expect(j).to.have.property('lowStock')); "
            ]
          }
        }
      ]
