        "body": {
          "mode": "raw",
          "raw": "{\n  \"assetType\": \"LAPTOP\",\n  \"reason\": \"Need a laptop for project work\",\n  \"priority\": \"HIGH\",\n  \"requiredDate\": \"2026-10-01\",\n  \"comments\": \"Please assign when available\"\n}"
